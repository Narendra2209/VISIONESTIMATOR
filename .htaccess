# Vision Estimators — Apache configuration (static site)

DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One canonical address: https://www.visionestimators.com
  # If the browser ever shows "too many redirects" after uploading, delete the next three lines.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://www.visionestimators.com%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^visionestimators\.com$ [NC]
  RewriteRule ^ https://www.visionestimators.com%{REQUEST_URI} [L,R=301]

  # /index.html -> /
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]

  # Pretty URLs also work: /about -> about.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^.]+)$ $1.html [L]
</IfModule>

# Pages from the previous site, moved permanently
<IfModule mod_alias.c>
  Redirect 301 /our-services.html /services.html
  Redirect 301 /why-us.html /about.html
  Redirect 301 /terms-of-service.html /terms-and-conditions.html
  Redirect 301 /service-drywall-estimation.html /service-material-takeoff.html
  Redirect 301 /service-plumbing-estimation.html /service-plumbing-estimating.html
  Redirect 301 /service-electrical-estimation.html /service-electrical-estimating.html
  Redirect 301 /service-sheet-metal-hvac.html /service-mechanical-estimating.html
  Redirect 301 /service-mep-estimating.html /services.html
  Redirect 301 /service-facade-cladding.html /service-cladding-estimating.html
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>
